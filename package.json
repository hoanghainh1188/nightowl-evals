{
  "name": "@hoanghainh/nightowl-evals",
  "version": "0.6.0",
  "description": "Record every time AI writes wrong code and turn those failures into a project-specific eval suite. Local-only.",
  "license": "Apache-2.0",
  "author": "Hoang Hai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoanghainh1188/nightowl-evals.git"
  },
  "homepage": "https://github.com/hoanghainh1188/nightowl-evals#readme",
  "bugs": {
    "url": "https://github.com/hoanghainh1188/nightowl-evals/issues"
  },
  "type": "module",
  "bin": {
    "nightowl": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "spec:validate": "openspec validate --all --strict",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.15.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
